{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "dist",
    "types": ["node", "webpack-env"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
